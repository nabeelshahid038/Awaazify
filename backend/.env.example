SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
FRONTEND_URL=http://localhost:5173
RVC_CLI_PATH=
PORT=8000
HOST=0.0.0.0

# Hybrid GPU Audio Engine Worker (Modal.com or Google Colab Cloudflare Tunnel)
# Leave blank to run local fallback DSP pipeline, or paste your Modal / Colab URL:
# Example: GPU_WORKER_URL=https://your-modal-app--process-cover.modal.run
# Example: GPU_WORKER_URL=https://xxxx-xx-xxx.trycloudflare.com
GPU_WORKER_URL=
GPU_WORKER_API_KEY=

# Dedicated, limited-scope Supabase key for the external GPU worker.
# SECURITY: the backend's SERVICE_ROLE key is NEVER sent to the worker.
# Create a separate restricted Supabase API key for the worker and put it here
# (and as GPU_WORKER_SUPABASE_KEY on Railway). The backend refuses to call the
# GPU worker when this is unset. Do NOT reuse SUPABASE_SERVICE_ROLE_KEY here.
GPU_WORKER_SUPABASE_KEY=

# Admin access: the SINGLE Gmail address allowed into the admin panel.
# The admin signs in with Google OAuth; the backend compares the verified
# JWT email against this value (case-insensitive). Must ALSO be set as the
# ADMIN_EMAIL env var on Railway. No database role edit is needed.
ADMIN_EMAIL=you@example.com

# Rate limiting (P2): max requests/minute per client IP on /api/* routes.
# Health, docs and root are exempt.
RATE_LIMIT_PER_MINUTE=60
# Stricter budget for abuse-sensitive endpoints (login/sync, payments).
RATE_LIMIT_STRICT_PER_MINUTE=20

# Sentry error tracking (P2): optional — the backend runs fine without it.
# Paste your Sentry DSN here (and as SENTRY_DSN on Railway) to enable.
SENTRY_DSN=
# SENTRY_RELEASE=awaazify-backend@1.0.0
# SENTRY_ENVIRONMENT=production
