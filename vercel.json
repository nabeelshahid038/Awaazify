{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": {
      "root": "backend",
      "entrypoint": "main:app"
    },
    "frontend": {
      "root": "frontend",
      "framework": "vite",
      "installCommand": "npm install --legacy-peer-deps"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
